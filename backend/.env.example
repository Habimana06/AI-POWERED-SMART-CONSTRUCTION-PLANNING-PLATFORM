# Copy to backend/.env (or use repo root .env — both are loaded)

MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your@gmail.com
NOTIFICATION_ADMIN_EMAIL=your@gmail.com

# Image generation fallbacks (recommended: at least one)
GEMINI_API_KEY=
XAI_API_KEY=
